# ==============================================================================
# Cynbit Smart Project Inquiry Builder — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# CRITICAL SECURITY RULES:
# 1. NEVER commit .env.local or paste real credentials into version control.
# 2. SUPABASE_SERVICE_ROLE_KEY is a privileged secret; keep it server-side only.
# 3. Do NOT prefix the service key with NEXT_PUBLIC_.
# ==============================================================================

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (SERVER-SIDE ONLY)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
