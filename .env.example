# ==============================================================================
# Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or expose your service role key in frontend code.

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (safe for public/client use, but not strictly needed if only server-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (SERVER-SIDE ONLY: Never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
